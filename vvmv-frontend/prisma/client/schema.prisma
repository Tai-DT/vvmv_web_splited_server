  localPath             String?               @map("local_path")
  authority             String?
  maLo                  String?               @map("ma_lo")
  transitPort           String?               @map("transit_port")
  destinationPort       String?               @map("destination_port")
  deliveryContactDetail String?               @map("delivery_contact_detail")
  eportService          String?               @map("eport_service")
  eportBooking          String?               @map("eport_booking")
  maNhanConmt           String?               @map("ma_nhan_conmt")
  soLenh                String?               @map("so_lenh")
  ngatDienDate          DateTime?             @map("ngat_dien_date")
  implementationDate    DateTime?             @map("implementation_date")
  isDeleted             Boolean               @default(false) @map("is_deleted")
  createdBy             String?               @map("created_by")
  domain                String?               @map("domain")
  isFinished            Boolean?              @default(false) @map("is_finished")
  parentJobNumber       String?               @map("parent_job_number")
  transactionCode       String?               @map("transaction_code")
  amount                Float?
