}

model ShippingLine {
  id            String         @id @default(uuid())
  name          String
  operationType OperationType? @map("operation_type")
  site          Site           @default(SGN)
  createdBy     String         @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  user          User           @relation("ShippingLineCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([name])
  @@index([site])
  @@map("shipping_lines")
}

model Vendor {
  id             String               @id @default(uuid())
  name           String
  site           Site                 @default(SGN)
  emails         String[]             @default([]) @map("emails")
  createdBy      String               @map("created_by")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  vendorCosts    VendorCost[]
  vendorFeeTypes VendorFeeType[]
  portalAccount  VendorPortalAccount?
  user           User                 @relation("VendorCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([name, site])
  @@index([name])
  @@index([site])
  @@map("vendors")
}

model Ops {
  id        String   @id @default(uuid())
  name      String
  site      Site     @default(SGN)
  emails    String[] @default([]) @map("emails")
  autoMail  Boolean  @default(false) @map("auto_mail")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation("OpsCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([name, site])
  @@index([name])
  @@index([site])
  @@map("ops")
}

model VendorPortalAccount {
  id           String   @id @default(uuid())
  vendorId     String   @unique @map("vendor_id")
  username     String   @unique
  passwordHash String   @map("password_hash")
  site         Site     @default(SGN)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([site, isActive])
  @@map("vendor_portal_account")
}

model VendorFeeType {
  id             String        @id @default(uuid())
  vendorId       String?       @map("vendor_id")
  site           Site          @default(SGN)
  feeCode        String?       @map("fee_code")
  feeDescription String?       @map("fee_description")
  name           String
  mode           VendorFeeMode @default(ALL)
  isNotDefault   Boolean       @default(false) @map("is_not_default")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  vendor         Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  costs          VendorCost[]

  @@index([site])
  @@index([feeCode])
  @@index([vendorId])
  @@index([isNotDefault])
  @@map("vendor_fee_type")
}

model VendorCost {
  id                 String              @id @default(uuid())
  truckingFollowUpId String              @map("trucking_follow_up_id")
  fcrId              String              @map("fcr_id")
  vendorId           String?             @map("vendor_id")
  feeTypeId          String?             @map("fee_type_id")
  feeName            String              @map("fee_name")
  isDisbursement     Boolean             @default(false) @map("is_disbursement")
  isSelling          Boolean             @default(false) @map("is_selling")
  vatPercent         Float?              @map("vat_percent")
  totalVat           Float?              @map("total_vat")
  totalFee           Float?              @map("total_fee")
  sellerTaxCode      String?             @map("seller_tax_code")
  invoiceNumber      String?             @map("invoice_number")
  invoiceLink        String?             @map("invoice_link")
  trackingCode       String?             @map("tracking_code")
  invoiceSentDate    String?             @map("invoice_sent_date")
  note               String?
  rowOrder           Int                 @default(1) @map("row_order")
  entryMode          VendorCostEntryMode @default(MANUAL) @map("entry_mode")
  createdByVendor    String?             @map("created_by_vendor")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  status             VendorCostStatus    @default(PENDING) @map("status")
  rejectionReason    String?             @map("rejection_reason")
  reviewMessage      String?             @map("review_message")
  reviewedById       String?             @map("reviewed_by_id")
  reviewedAt         DateTime?           @map("reviewed_at")
  fcr                FCR                 @relation(fields: [fcrId], references: [id], onDelete: Cascade)
  feeType            VendorFeeType?      @relation(fields: [feeTypeId], references: [id])
  reviewer           User?               @relation("VendorCostReviewer", fields: [reviewedById], references: [id])
  truckingFollowUp   TruckingFollowUp    @relation(fields: [truckingFollowUpId], references: [id], onDelete: Cascade)
  vendor             Vendor?             @relation(fields: [vendorId], references: [id])

  erpLogs VendorCostErpLog[]

  @@index([truckingFollowUpId])
  @@index([fcrId])
  @@index([vendorId])
  @@index([feeTypeId])
  @@index([createdAt])
  @@index([status])
  @@index([reviewedById])
  @@index([fcrId, status])
  @@map("vendor_cost")
}

model VendorCostErpLog {
  id           String     @id @default(uuid())
  vendorCostId String     @map("vendor_cost_id")
  caseNumber   Int        @map("case_number")
  erpPayload   Json       @map("erp_payload")
  arPayload    Json?      @map("ar_payload")
  createdAt    DateTime   @default(now()) @map("created_at")
  vendorCost   VendorCost @relation(fields: [vendorCostId], references: [id], onDelete: Cascade)

  @@index([vendorCostId])
  @@map("vendor_cost_erp_log")
}

