model GeminiHistory {
  id               String   @id @default(uuid())
  jobNumber        String?  @map("job_number")
  userId           String?  @map("user_id")
  userName         String?  @map("user_name")
  model            String?
  prompt           String?
  response         String?
  errorMessage     String?  @map("error_message")
  userCustomPrompt String?  @map("user_custom_prompt")
  taxCode          String?  @map("tax_code")
  operationType    String?  @map("operation_type")
  serviceMode      String?  @map("service_mode")
  status           Int?
  fileIds          String[] @map("file_ids")
  fileNames        String[] @map("file_names")
  totalFileSizeMb  Float?   @map("total_file_size_mb")
  requestBody      Json?    @map("request_body")
  promptTokens     Int?     @map("prompt_tokens")
  candidatesTokens Int?     @map("candidates_tokens")
  totalTokens      Int?     @map("total_tokens")
  durationMs       Int?     @map("duration_ms")
  goal             String?
