generator client {
  provider = "prisma-client-js"
  output   = "../prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum CdsStatus {
  DRAFT
  REGISTERED
}

model User {
  id                         String                @id
  name                       String?
  email                      String                @unique
  emailVerified              Boolean               @default(false)
  image                      String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  displayUsername            String?
  taxNumber                  String?
  username                   String?               @unique
  banExpires                 DateTime?
  banReason                  String?
  banned                     Boolean               @default(false)
  erpAccount                 String?
  role                       UserRole              @default(STAFF)
  site                       Site?
  accounts                   Account[]
  apiKeys                    ApiKey[]
  companyColors              CompanyColor[]
  containerSizeConfigs       ContainerSizeConfig[] @relation("ContainerSizeConfigCreator")
  fieldOptions               FieldOption[]         @relation("FieldOptionCreator")
  fieldTemplates             FieldTemplate[]
  followUps                  FollowUp[]
  foreignPorts               ForeignPort[]         @relation("ForeignPortCreator")
  ops                        Ops[]                 @relation("OpsCreator")
  partnersMasterData         PartnersMasterData[]
  paymentRequests            PaymentRequest[]
  pickOrLiftPlaces           PickOrLiftPlace[]     @relation("PickOrLiftPlaceCreator")
  sessions                   Session[]
  shippingLines              ShippingLine[]        @relation("ShippingLineCreator")
  tablePreferences           TablePreference[]
  teamLeaderships            TeamLeader[]          @relation("TeamLeaders")
  teamMemberships            TeamMember[]          @relation("TeamMembers")
  truckingFollowUps          TruckingFollowUp[]    @relation("TruckingFollowUpToUser")
  truckingFollowUpsAsHandler TruckingFollowUp[]    @relation("TruckingFollowUpHandler")
  truckingNumbers            TruckingNumber[]
  departmentAssignments      UserDepartment[]      @relation("UserDepartments")
  reviewedVendorCosts        VendorCost[]          @relation("VendorCostReviewer")
  vendors                    Vendor[]              @relation("VendorCreator")
  warehouseConfigs           WarehouseConfig[]
  customsWarehouses          CustomsWarehouse[]    @relation("CustomsWarehouseCreator")

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  userId    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accessToken           String?
  refreshToken          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  accountId             String
  providerId            String
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model UserDepartment {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  departmentId String     @map("department_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  department   Department @relation("DepartmentManagers", fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation("UserDepartments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
  @@map("user_department")
}

model Department {
  id          String           @id @default(uuid())
  name        String
  description String?
  site        Site
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  teams       Team[]
  managers    UserDepartment[] @relation("DepartmentManagers")

  @@unique([name, site])
  @@map("department")
}

model Team {
  id           String       @id @default(uuid())
  name         String
  site         Site
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  departmentId String?      @map("department_id")
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  leaders      TeamLeader[]
  members      TeamMember[]

  @@index([departmentId])
  @@map("team")
}

model TeamLeader {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation("TeamLeaders", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_leader")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation("TeamMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_member")
}

model FollowUp {
  id                     String                  @id @default(uuid())
  botMessage             String?                 @map("bot_message")
  operationType          OperationType?          @map("operation_type")
  taxCode                String?                 @map("tax_code")
  companyName            String?                 @map("company_name")
  jobNumber              String?                 @map("job_number")
  driveUrl               String?                 @map("drive_url")
  localPath              String?                 @map("local_path")
  notes                  String?
  cargoType              String?                 @map("cargo_type")
  cbm                    Float?
  deliveryDate           DateTime?               @map("delivery_date")
  truckNumber            String?                 @map("truck_number")
  location               String?
  supervisionGate        String?                 @map("supervision_gate")
  handler                String?
  startTime              DateTime?               @map("start_time")
  endTime                DateTime?               @map("end_time")
  poNumber               String?                 @map("po_number")
  note2                  String?                 @map("note_2")
  note3                  String?                 @map("note_3")
  shmtDate               DateTime?               @map("shmt_date")
  domain                 Site?
  arNumber               String?                 @map("ar_number")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  createdBy              String                  @map("created_by")
  coNumber               String?                 @map("co_number")
  loadingLocation        String?                 @map("loading_location")
  pickupLocation         String?                 @map("pickup_location")
  taxService             String?                 @map("tax_service")
  transportDate          DateTime?               @map("transport_date")
  transportMethod        String?                 @map("transport_method")
  unit                   String?
  serviceMode            String?                 @map("service_mode")
  workType               String?                 @map("work_type")
  pol                    String?
  pod                    String?
  warehouse              String?
  authority              String?
  billOrBooking          String?                 @map("bill_or_booking")
  quantity               Int?
  supplier               String?
  grossWeight            Float?                  @map("gross_weight")
  invoice                String?
  requestTruckingNo      String?                 @map("request_trucking_no")
  etaEtd                 DateTime?               @map("eta_etd")
  pickUpTime             String?                 @map("pick_up_time")
  commodityName          String?                 @map("commodity_name")
  isDeleted              Boolean                 @default(false) @map("is_deleted")
  jobPriority            Int?                    @default(3) @map("job_priority")
  isFinished             Boolean                 @default(false) @map("is_finished")
  cargoLists             CargoList[]
  cerOfOrigins           CerOfOrigin[]
  containers             Container[]
  declarations           Declaration[]
  ecusDeclarationMirrors EcusDeclarationMirror[]
  user                   User                    @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activityLogs           FollowUpActivityLog[]
  cdsInfo                FollowUpCdsInfo?
  paymentRequests        PaymentRequest[]

  @@map("follow_up")
}

model FollowUpCdsInfo {
  id                                String                    @id @default(uuid())
  followUpId                        String                    @unique @map("follow_up_id")
  operationCode                     String?                   @map("operation_code")
  transportMethodCode               String?                   @map("transport_method_code")
  customsCode                       String?                   @map("customs_code")
  personOrganizationClassification  String?                   @map("person_organization_classification")
  declarationProcessingDeptCode     String?                   @map("declaration_processing_dept_code")
  importExportUnitName              String?                   @map("import_export_unit_name")
  importExportBusinessAddress       String?                   @map("import_export_business_address")
  partnerName                       String?                   @map("partner_name")
  partnerAddress1                   String?                   @map("partner_address_1")
  partnerAddress2                   String?                   @map("partner_address_2")
  partnerAddress3                   String?                   @map("partner_address_3")
  partnerAddress4                   String?                   @map("partner_address_4")
  exportCountryCode                 String?                   @map("export_country_code")
  billOfLading                      String?                   @map("bill_of_lading")
  packageQuantity                   Float?                    @map("package_quantity")
  packageType                       String?                   @map("package_type")
  grossWeightTotal                  Float?                    @map("gross_weight_total")
  weightUnit                        String?                   @map("weight_unit")
  containerQuantity                 Float?                    @map("container_quantity")
  warehouseLocationCode             String?                   @map("warehouse_location_code")
  unloadingLocationCode             String?                   @map("unloading_location_code")
  loadingLocationCode               String?                   @map("loading_location_code")
  transportVehicleCode              String?                   @map("transport_vehicle_code")
  departureArrivalDate              String?                   @map("departure_arrival_date")
  licenseNumber                     String?                   @map("license_number")
  warehouseLocationName             String?                   @map("warehouse_location_name")
  unloadingLocationName             String?                   @map("unloading_location_name")
  loadingLocationName               String?                   @map("loading_location_name")
  transportVehicleName              String?                   @map("transport_vehicle_name")
  commercialInvoice                 String?                   @map("commercial_invoice")
  invoiceFormClassificationCode     String?                   @map("invoice_form_classification_code")
  commercialInvoiceDate             String?                   @map("commercial_invoice_date")
  invoicePriceCondition             String?                   @map("invoice_price_condition")
  paymentMethod                     String?                   @map("payment_method")
  invoiceClassificationCode         String?                   @map("invoice_classification_code")
  declaredValue                     Float?                    @map("declared_value")
  totalInvoiceValue                 Float?                    @map("total_invoice_value")
  totalTaxableValue                 Float?                    @map("total_taxable_value")
  invoiceCurrency                   String?                   @map("invoice_currency")
  taxableValueCurrencyCode          String?                   @map("taxable_value_currency_code")
  valuationDeclarationTypeCode      String?                   @map("valuation_declaration_type_code")
  transportFee                      Float?                    @map("transport_fee")
  transportFeeClassificationCode    String?                   @map("transport_fee_classification_code")
  transportFeeCurrencyCode          String?                   @map("transport_fee_currency_code")
  insuranceFee                      Float?                    @map("insurance_fee")
  insuranceFeeClassificationCode    String?                   @map("insurance_fee_classification_code")
  insuranceFeeCurrencyCode          String?                   @map("insurance_fee_currency_code")
  taxPayer                          String?                   @map("tax_payer")
  releaseBeforePermitCode           String?                   @map("release_before_permit_code")
  taxPaymentDeadlineCode            String?                   @map("tax_payment_deadline_code")
  taxDestinationLocation            String?                   @map("tax_destination_location")
  finalDestinationName              String?                   @map("final_destination_name")
  estimatedArrivalAtDestinationDate String?                   @map("estimated_arrival_at_destination_date")
  transportDepartureDate            String?                   @map("transport_departure_date")
  note                              String?
  contractNumber                    String?                   @map("contract_number")
  contractDate                      String?                   @map("contract_date")
  contractGoodsDate                 String?                   @map("contract_goods_date")
  importLicense                     String?                   @map("import_license")
  internalBusinessManagementNumber  String?                   @map("internal_business_management_number")
  otherLegalDocumentCode            String?                   @map("other_legal_document_code")
  valuationDeclarationDetail        String?                   @map("valuation_declaration_detail")
  truckLoadingLocationCode          String?                   @map("truck_loading_location_code")
  truckLoadingLocationName          String?                   @map("truck_loading_location_name")
  truckLoadingLocationAddress       String?                   @map("truck_loading_location_address")
  cdsStatus                         CdsStatus                 @default(DRAFT) @map("cds_status")
  ecusDeclarationId                 Int?                      @map("ecus_declaration_id")
  registeredAt                      DateTime?                 @map("registered_at")
  registeredBy                      String?                   @map("registered_by")
  createdAt                         DateTime                  @default(now()) @map("created_at")
  updatedAt                         DateTime                  @updatedAt @map("updated_at")
  airportSupervisionEnabled         Boolean?                  @map("airport_supervision_enabled")
  branchNumberPart1                 String?                   @map("branch_number_part_1")
  branchNumberPart2                 String?                   @map("branch_number_part_2")
  businessTypeGroup                 String?                   @map("business_type_group")
  exchangeRate                      Float?                    @map("exchange_rate")
  netWeight                         Float?                    @map("net_weight")
  cargoClassificationCode           String?                   @map("cargo_classification_code")
  correspondingDeclarationNumber    String?                   @map("corresponding_declaration_number")
  customsDeclarantCode              String?                   @map("customs_declarant_code")
  declarationNumber                 String?                   @map("declaration_number")
  declarationSequenceNumber         String?                   @map("declaration_sequence_number")
  entrustedExporterName             String?                   @map("entrusted_exporter_name")
  entrustedImporterCode             String?                   @map("entrusted_importer_code")
  entrustedImporterName             String?                   @map("entrusted_importer_name")
  expectedDeclarationDate           String?                   @map("expected_declaration_date")
  exporterCode                      String?                   @map("exporter_code")
  exporterPostalCode                String?                   @map("exporter_postal_code")
  firstDeclarationNumber            String?                   @map("first_declaration_number")
  importerCode                      String?                   @map("importer_code")
  importerPhone                     String?                   @map("importer_phone")
  importerPostalCode                String?                   @map("importer_postal_code")
  inspectionResultCode              String?                   @map("inspection_result_code")
  packageMarks                      String?                   @map("package_marks")
  reExportDeadline                  String?                   @map("re_export_deadline")
  seaportSupervisionEnabled         Boolean?                  @map("seaport_supervision_enabled")
  electronicInvoiceReceiptNumber    String?                   @map("electronic_invoice_receipt_number")
  insuranceRegistrationNumber       String?                   @map("insurance_registration_number")
  valuationSummaryReceiptNumber     String?                   @map("valuation_summary_receipt_number")
  taxSubstituteBankCode             String?                   @map("tax_substitute_bank_code")
  creditLimitIssueYear              String?                   @map("credit_limit_issue_year")
  guaranteeIssueYear                String?                   @map("guarantee_issue_year")
  guaranteeBankCode                 String?                   @map("guarantee_bank_code")
  creditLimitDocumentSymbol         String?                   @map("credit_limit_document_symbol")
  creditLimitDocumentNumber         String?                   @map("credit_limit_document_number")
  guaranteeDocumentSymbol           String?                   @map("guarantee_document_symbol")
  guaranteeDocumentNumber           String?                   @map("guarantee_document_number")
  billItemRows                      CdsBillItem[]
  valuationAdjustmentRows           CdsValuationAdjustment[]
  transportScheduleRows             CdsTransportSchedule[]
  importLicenseRows                 CdsImportLicense[]
  otherLegalDocumentRows            CdsOtherLegalDocument[]
  electronicAttachmentRows          CdsElectronicAttachment[]
  followUp                          FollowUp                  @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  @@index([followUpId])
  @@map("follow_up_cds_info")
}

model CdsBillItem {
  id         String          @id @default(uuid())
  cdsInfoId  String          @map("cds_info_id")
  sortOrder  Int             @default(0) @map("sort_order")
  billNumber String?         @map("bill_number")
  billDate   String?         @map("bill_date")
  hawbNumber String?         @map("hawb_number")
  mawbYear   String?         @map("mawb_year")
  cdsInfo    FollowUpCdsInfo @relation(fields: [cdsInfoId], references: [id], onDelete: Cascade)

  @@index([cdsInfoId, sortOrder])
  @@map("cds_bill_item")
}

model CdsValuationAdjustment {
  id                 String          @id @default(uuid())
  cdsInfoId          String          @map("cds_info_id")
  sortOrder          Int             @default(0) @map("sort_order")
  nameCode           String?         @map("name_code")
  classificationCode String?         @map("classification_code")
  currencyCode       String?         @map("currency_code")
  adjustmentValue    Float?          @map("adjustment_value")
  allocationRatio    Float?          @map("allocation_ratio")
  cdsInfo            FollowUpCdsInfo @relation(fields: [cdsInfoId], references: [id], onDelete: Cascade)

  @@index([cdsInfoId, sortOrder])
  @@map("cds_valuation_adjustment")
}

model CdsTransportSchedule {
  id            String          @id @default(uuid())
  cdsInfoId     String          @map("cds_info_id")
  sortOrder     Int             @default(0) @map("sort_order")
  locationCode  String?         @map("location_code")
  locationName  String?         @map("location_name")
  arrivalDate   String?         @map("arrival_date")
  departureDate String?         @map("departure_date")
  cdsInfo       FollowUpCdsInfo @relation(fields: [cdsInfoId], references: [id], onDelete: Cascade)

  @@index([cdsInfoId, sortOrder])
  @@map("cds_transport_schedule")
}

model CdsImportLicense {
  id            String          @id @default(uuid())
  cdsInfoId     String          @map("cds_info_id")
  sortOrder     Int             @default(0) @map("sort_order")
  licenseNumber String?         @map("license_number")
  cdsInfo       FollowUpCdsInfo @relation(fields: [cdsInfoId], references: [id], onDelete: Cascade)

  @@index([cdsInfoId, sortOrder])
  @@map("cds_import_license")
}

model CdsOtherLegalDocument {
  id           String          @id @default(uuid())
  cdsInfoId    String          @map("cds_info_id")
  sortOrder    Int             @default(0) @map("sort_order")
  documentCode String?         @map("document_code")
  cdsInfo      FollowUpCdsInfo @relation(fields: [cdsInfoId], references: [id], onDelete: Cascade)

  @@index([cdsInfoId, sortOrder])
  @@map("cds_other_legal_document")
}

model CdsElectronicAttachment {
  id                    String          @id @default(uuid())
  cdsInfoId             String          @map("cds_info_id")
  sortOrder             Int             @default(0) @map("sort_order")
  attachmentNumber      String?         @map("attachment_number")
  attachmentDescription String?         @map("attachment_description")
  cdsInfo               FollowUpCdsInfo @relation(fields: [cdsInfoId], references: [id], onDelete: Cascade)

  @@index([cdsInfoId, sortOrder])
  @@map("cds_electronic_attachment")
}

