  newValue           Json?            @map("new_value")
  createdAt          DateTime         @default(now()) @map("created_at")
  truckingFollowUp   TruckingFollowUp @relation(fields: [truckingFollowUpId], references: [id], onDelete: Cascade)

  @@index([truckingFollowUpId, createdAt(sort: Desc)])
  @@map("trucking_activity_log")
}

model FollowUpActivityLog {
