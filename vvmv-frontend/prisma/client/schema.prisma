model CdsLookupSnapshot {
  id          String   @id @default(uuid())
  source      String?
  generatedAt DateTime @default(now()) @map("generated_at")
  importedAt  DateTime @default(now()) @map("imported_at")
  isActive    Boolean  @default(true) @map("is_active")

  @@index([isActive, generatedAt])
  @@map("cds_lookup_snapshot")
}

model CdsOperationCodeLookup {
  code      String @id
  name      String
  direction String @default("unknown")

  @@index([direction])
  @@map("cds_operation_code_lookup")
}

model CdsPermitLookup {
  id                      String  @id
  kind                    String
  permitTypeCode          String? @map("permit_type_code")
  permitTypeName          String? @map("permit_type_name")
  permitNo                String  @map("permit_no")
  permitIssueDate         String? @map("permit_issue_date")
  permitExpiryDate        String? @map("permit_expiry_date")
  declarationCount        Int?    @map("declaration_count")
  firstDeclarationDate    String? @map("first_declaration_date")
  lastDeclarationDate     String? @map("last_declaration_date")
  sampleDeclarationNo     String? @map("sample_declaration_no")
  sampleCustomsCode       String? @map("sample_customs_code")
  isExplicitImportLicense Boolean @default(false) @map("is_explicit_import_license")

  @@unique([kind, permitTypeCode, permitNo])
  @@index([kind])
  @@index([permitTypeCode])
  @@index([permitNo])
  @@map("cds_permit_lookup")
}

model CdsPermitTypeLookup {
  code String @id
  name String

  @@map("cds_permit_type_lookup")
}

model CdsProcessingDepartmentLookup {
  code           String
  customsCode    String  @map("customs_code")
  name           String
  operationCodes Json?   @map("operation_codes")
  allowImport    Boolean @default(false) @map("allow_import")
  allowExport    Boolean @default(false) @map("allow_export")

  @@id([code, customsCode])
  @@index([customsCode])
  @@map("cds_processing_department_lookup")
}

model CdsFieldOptionLookup {
  id        String  @id @default(uuid())
  field     String
  value     String
  label     String?
  address   String?
  count     Int     @default(0)
  direction String  @default("unknown")
  source    String  @default("snapshot")

  @@unique([field, value, direction, source])
