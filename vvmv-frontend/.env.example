# Copy to `.env` + `.env.local` as needed (never commit secrets).
#
# ── FE ↔ Nest wiring ───────────────────────────────────────────────────────
# • DATABASE_URL must match `vvmv-backend` — sessions live in Postgres;
#   Nest reads `better-auth.session_token` from cookies against the same DB.
#
# • BACKEND_URL (server-only): Next rewrites registered `/api/*` routes to Nest.
#   Example local: BACKEND_URL=http://127.0.0.1:3001
#
# • Leave NEXT_PUBLIC_API_URL unset when the browser should talk to THIS Next app
#   on `/api/*` (cookies stay same-origin; Next proxies to Nest via BACKEND_URL).
#   Only set NEXT_PUBLIC_API_URL when the UI truly calls a separate API origin
#   (split hosts — then configure Nest CORS_ORIGIN + cookie SameSite accordingly).

DATABASE_URL="postgresql://USER:PASS@HOST:PORT/DB?schema=public"

# Same value as `vvmv-backend` BETTER_AUTH_SECRET (vendor portal + signing).
BETTER_AUTH_SECRET=

# Used for server-side auth absolute URLs + trusted origins — not as the browser auth client base.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Nest rewrite target (do not use NEXT_PUBLIC_* — not exposed to browser).
BACKEND_URL="http://127.0.0.1:3001"

# Browser REST API origin when UI and API are on different hosts (see lib/api/client.ts).
# Do NOT point this at Nest while Better Auth runs on Next — it breaks login (use APP_URL for auth).
# NEXT_PUBLIC_API_URL="https://api.example.com"

# Only when `/api/auth` is on another origin than the page (rare). Leave unset for same-origin auth.
# NEXT_PUBLIC_BETTER_AUTH_URL="https://auth.example.com"

# Server-side absolute URL for Better Auth links (defaults to NEXT_PUBLIC_APP_URL chain).
# BETTER_AUTH_BASE_URL="http://localhost:3000"

# Comma-separated — add all UI origins that call /api/auth in split mode.
# AUTH_TRUSTED_ORIGINS="http://localhost:3000,https://app.example.com"

# Google OAuth (optional — omitted => email/password + other methods only).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
