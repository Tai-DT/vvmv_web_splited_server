# Copy to `.env` (never commit).
#
# ── FE ↔ Nest wiring ───────────────────────────────────────────────────────
# • DATABASE_URL must be the same database as `vvmv-frontend` so session rows
#   match what Next (Better Auth) creates and what Nest looks up.
#
# • BETTER_AUTH_SECRET should match the Next app value (used for shared signing
#   e.g. vendor portal tokens in `compat-api.service.ts`).

DATABASE_URL="postgresql://USER:PASS@HOST:PORT/DB?schema=public"
BETTER_AUTH_SECRET=

PORT=3001
HOST=0.0.0.0

# When the browser calls Nest directly (e.g. NEXT_PUBLIC_API_URL points here),
# list allowed UI origins, comma-separated. If all API traffic goes through
# Next rewrites (BACKEND_URL on the frontend), you can leave this unset.
# CORS_ORIGIN=http://localhost:3000

# Integrations (see vvmv-backend README) — set as needed.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GEMINI_API_KEY=
# FASTPRO_API_KEY=
# SNP_SESSION_COOKIE=
# MSSQL_HCM_* / MSSQL_HAN_* (ERP)

# Optional local override for /followup/cargo-unit-codes.
# Defaults to ../ai-vvmv/.../database-exports/cds_cargo_unit_codes.json in this workspace.
# CDS_CARGO_UNIT_CODES_PATH=
